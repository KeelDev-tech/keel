+def _serialized(function):
+    """Serialize acquire/release/takeover around a persistent per-path flock.
+
+    Every participating process must run this version; never unlink the .mutex.
+    Launch leases are not submission holds and must not be used to clear them.
+    """
+    @functools.wraps(function)
+    def wrapped(role_id, *args, **kwargs):
+        os.makedirs(LOCK_DIR, exist_ok=True)
+        with open(_lock_path(role_id) + ".mutex", "a+") as handle:
+            fcntl.flock(handle, fcntl.LOCK_EX)
+            try:
+                return function(role_id, *args, **kwargs)
+            finally:
+                fcntl.flock(handle, fcntl.LOCK_UN)
+    return wrapped
+
