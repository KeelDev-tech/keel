+def _document_entries(document):
+    if isinstance(document, list):
+        rows = document
+    elif isinstance(document, dict):
+        keys = [k for k in ("leads", "entries", "items") if k in document]
+        if len(keys) != 1:
+            raise ValueError("ambiguous queue wrapper")
+        rows = document[keys[0]]
+    else:
+        raise ValueError("invalid queue document")
+    if not isinstance(rows, list) or any(not isinstance(x, dict) for x in rows):
+        raise ValueError("invalid queue rows")
+    return rows
+
