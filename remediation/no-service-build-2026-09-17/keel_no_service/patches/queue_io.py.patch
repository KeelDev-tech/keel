+def patch_entry(path, role_id, fields, lock_path=None):
+    """Merge one existing entry, preserving wrapper metadata and queue shape."""
+    with queue_lock(owner=f"patch_entry:{role_id}", lock_path=lock_path):
+        with open(path) as handle:
+            document = json.load(handle)
+        matches = [e for e in _document_entries(document) if e.get("role_id") == role_id]
+        if len(matches) > 1:
+            raise ValueError("ambiguous role identity; refusing mutation")
+        if not matches:
+            return False
+        matches[0].update(fields)
+        atomic_write_json(path, document)
+        return True
+
